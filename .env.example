# Copy to .env (scripts/setup-local-environment.ps1 does this automatically).
# .env is ignored by Git. Never commit real API keys.

# Local database (Docker). These values are for local development only.
CAMPUS_RAG_DB_HOST=127.0.0.1
CAMPUS_RAG_DB_PORT=5433
CAMPUS_RAG_DB_USER=campus_rag
CAMPUS_RAG_DB_PASSWORD=campus_rag_local
CAMPUS_RAG_DB_NAME=campus_rag

# Optional: a full connection string overrides the CAMPUS_RAG_DB_* values above.
# CAMPUS_RAG_DATABASE_URL=postgresql://campus_rag:campus_rag_local@127.0.0.1:5433/campus_rag

# Local embedding model server (Ollama in Docker). Host port for the ollama service.
CAMPUS_RAG_OLLAMA_PORT=11434

# Embeddings: any OpenAI-compatible /embeddings endpoint. Defaults use the local Ollama server.
# Keep the base URL port in step with CAMPUS_RAG_OLLAMA_PORT.
CAMPUS_RAG_EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
CAMPUS_RAG_EMBEDDING_MODEL=nomic-embed-text
# Vector size the model returns; the setup script checks it.
CAMPUS_RAG_EMBEDDING_DIMENSIONS=768
# Task prefixes nomic-embed-text expects. Keep the quotes: the trailing space is part of the prefix.
CAMPUS_RAG_EMBEDDING_DOCUMENT_PREFIX="search_document: "
CAMPUS_RAG_EMBEDDING_QUERY_PREFIX="search_query: "
# Optional: API key for a hosted embedding provider. The local Ollama server needs none.
# CAMPUS_RAG_EMBEDDING_API_KEY=

# The answer-generation model arrives in milestone 7; it has no settings yet.
